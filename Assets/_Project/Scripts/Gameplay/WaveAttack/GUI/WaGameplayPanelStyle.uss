.root-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.4);
    position: absolute;
}

.panel-container {
    width: 800px;
    height: 450px;
    background-color: rgb(35, 35, 35);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(120, 120, 120);
    flex-direction: row;
    overflow: hidden;
}

.close-btn {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 30px;
    height: 30px;
    background-color: rgb(200, 50, 50);
    color: white;
    -unity-font-style: bold;
    border-radius: 6px;
    border-width: 0;
    /*z-index: 10; !* Đảm bảo nút nằm trên cùng *!*/
}

.close-btn:hover {
    background-color: rgb(230, 80, 80);
}

/* ==================== LEFT PANEL ==================== */
.left-panel {
    flex: 7; /* Chiếm 7 phần (70%) */
    background-color: rgb(40, 40, 40);
    padding: 20px;
    border-right-width: 2px;
    border-right-color: rgb(80, 80, 80);
}

.panel-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
    margin-bottom: 15px;
    -unity-text-align: middle-center;
}

.army-list {
    flex-grow: 1;
}
.army-list .unity-scroll-view__content-container {
    flex-direction: column;
}

.army-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(55, 55, 55);
    padding: 10px;
    margin-bottom: 8px;
    border-radius: 8px;
}

.army-name-container {
    flex-direction: column;
    width: 35%;
}

.army-name-lbl {
    font-size: 18px;
    color: rgb(255, 215, 0); /* Màu vàng hoàng kim */
    -unity-font-style: bold;
}

.army-global-lbl {
    font-size: 14px;
    color: rgb(180, 180, 180);
}

.army-controls {
    flex-direction: row;
    align-items: center;
    width: 65%;
    justify-content: flex-end;
}

.army-controls Button {
    width: 35px;
    height: 35px;
    font-size: 18px;
    -unity-font-style: bold;
    border-radius: 6px;
    background-color: rgb(80, 80, 80);
    color: white;
    border-width: 0;
    margin-left: 3px;
    margin-right: 3px;
    transition-duration: 0.1s;
}

.army-controls Button:hover {
    background-color: rgb(110, 110, 110);
    scale: 1.05;
}

.army-count-input {
    width: 50px;
    height: 35px;
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(30, 30, 30);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(100, 100, 100);
    margin-left: 3px;
    margin-right: 3px;
}

.army-count-input .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-center;
    color: white;
    padding: 0;
}

.army-count-input:focus .unity-text-field__input {
    color: rgb(255, 200, 200);
}

/* ==================== RIGHT PANEL ==================== */
.right-panel {
    flex: 3; /* Chiếm 3 phần (30%) */
    background-color: rgb(35, 35, 35);
    padding: 20px;
}

.rule-title {
    color: rgb(100, 200, 255);
}

.rule-container {
    flex-direction: column;
    margin-top: 10px;
    background-color: rgb(50, 50, 50);
    border-radius: 8px;
    padding: 10px;
}

.rule-row {
    flex-direction: column;
    margin-bottom: 12px;
}

.rule-label-title {
    font-size: 14px;
    color: rgb(180, 180, 180);
    margin-bottom: 2px;
}

.rule-label-value {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-right;
}

.separator {
    height: 2px;
    background-color: rgb(80, 80, 80);
    margin-top: 5px;
    margin-bottom: 15px;
}
.root-container {
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5); /* Thay thế blur nếu không có Blur component */
    position: absolute;
}

.panel-container {
    width: 600px;
    background-color: rgb(45, 45, 45);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    padding: 20px;
}

.header-section {
    align-items: center;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-color: rgb(80, 80, 80);
    padding-bottom: 10px;
}

.header-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(240, 240, 240);
}

.list-section {
    height: 300px;
    margin-bottom: 20px;
    background-color: rgb(35, 35, 35);
    border-radius: 8px;
    padding: 10px;
}

/* Fix lỗi scrollview trên UIToolkit */
.list-section .unity-scroll-view__content-container {
    flex-direction: column;
}

.footer-section {
    flex-direction: row;
    justify-content: space-between;
}

.btn {
    width: 48%;
    height: 50px;
    border-radius: 8px;
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
    transition-duration: 0.1s;
}

.btn-primary {
    background-color: rgb(200, 50, 50);
    border-color: rgb(150, 30, 30);
}

.btn-primary:hover {
    background-color: rgb(220, 70, 70);
    scale: 1.02;
}

.btn-secondary {
    background-color: rgb(100, 100, 100);
    border-color: rgb(70, 70, 70);
}

.btn-secondary:hover {
    background-color: rgb(120, 120, 120);
    scale: 1.02;
}

.army-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgb(55, 55, 55);
    padding: 10px;
    margin-bottom: 8px;
    border-radius: 6px;
}

.army-name-lbl {
    font-size: 18px;
    color: rgb(220, 220, 220);
    -unity-font-style: bold;
    width: 45%;
}

.army-controls {
    flex-direction: row;
    align-items: center;
    width: 50%;
    justify-content: flex-end;
}

.army-controls Button {
    width: 45px;
    height: 40px;
    font-size: 18px;
    -unity-font-style: bold;
    border-radius: 6px;
    background-color: rgb(80, 80, 80);
    color: white;
    border-width: 0;
    margin-left: 5px;
    margin-right: 5px;
}

.army-controls Button:hover {
    background-color: rgb(110, 110, 110);
}

/* Định dạng mới cho TextField nhập số lượng quân */
.army-count-input {
    width: 60px;
    height: 40px;
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(30, 30, 30);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(100, 100, 100);
    margin-left: 5px;
    margin-right: 5px;
}

/* Xóa viền mặc định của TextElement bên trong TextField */
.army-count-input .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    -unity-text-align: middle-center;
    color: white;
    padding: 0;
}

/* Hiệu ứng khi focus vào ô nhập liệu */
.army-count-input:focus .unity-text-field__input {
    color: rgb(255, 200, 200); /* Đổi màu chữ nhẹ khi được chọn */
}